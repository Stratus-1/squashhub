{
  "headers": [
    {
      "source": "/(auth|dashboard|bookings|ladder|challenges|profile|notifications|reset-password|integrations)(/.*)?",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "crons": [
    { "path": "/api/cron/expire", "schedule": "0 * * * *" }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
